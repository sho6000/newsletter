{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/newsletter/**",
              "ui_kits/newsletter/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:clay|marigold|sky|vermilion|outline)$/]",
        "message": "<Badge> tone must be one of 'clay' | 'marigold' | 'sky' | 'vermilion' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|iconAfter|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, iconAfter, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|alert)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: label, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:marigold|sky|vermilion)$/]",
        "message": "<Callout> tone must be one of 'marigold' | 'sky' | 'vermilion'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|raised|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, raised, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|marigold|clay|sky|vermilion)$/]",
        "message": "<Card> tone must be one of 'paper' | 'marigold' | 'clay' | 'sky' | 'vermilion'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|nodes|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant, nodes."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rule|hairline|constellation)$/]",
        "message": "<Divider> variant must be one of 'rule' | 'hairline' | 'constellation'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:preheader|flat|children|key|ref|className|style|children)$/]",
        "message": "<EmailShell> doesn't accept that prop. Declared props: preheader, flat, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Masthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|issue|date|kicker|logoSrc|key|ref|className|style|children)$/]",
        "message": "<Masthead> doesn't accept that prop. Declared props: title, issue, date, kicker, logoSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|role|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, attribution, role."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|dot|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|excerpt|href|cta|imageSrc|imageAlt|layout|key|ref|className|style|children)$/]",
        "message": "<StoryItem> doesn't accept that prop. Declared props: eyebrow, title, excerpt, href, cta, imageSrc, imageAlt, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryItem'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|side)$/]",
        "message": "<StoryItem> layout must be one of 'stacked' | 'side'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaglineStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|key|ref|className|style|children)$/]",
        "message": "<TaglineStrip> doesn't accept that prop. Declared props: items, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaglineStrip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:clay|marigold|plain)$/]",
        "message": "<TaglineStrip> tone must be one of 'clay' | 'marigold' | 'plain'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
